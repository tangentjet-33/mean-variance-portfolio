# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# Environment and build artifacts
.env
.venv/
env/
venv/

# Data files — we fetch at runtime, don't commit cached CSVs
data/**/*.csv
data/**/*.parquet
!data/.gitkeep

# Outputs generated by the code
outputs/**/*.png
outputs/**/*.pdf
!outputs/.gitkeep

# OS and editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Notebooks — local exploration only, not part of the deliverable
notebooks/*.ipynb
!notebooks/.gitkeep
